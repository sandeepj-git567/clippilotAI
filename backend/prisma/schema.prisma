datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  SUBMITTED
  RIGHTS_CHECK
  QUEUED
  IMPORTING
  TRANSCRIBING
  ANALYZING
  CLIPPING
  EDITING
  QUALITY_CHECK
  READY
  APPROVED
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
  CANCELLED
}

enum EditingFormat {
  SPLIT_SCREEN
  FULL_SCREEN
  FACECAM
}

enum PublishingPreference {
  MANUAL
  SCHEDULED
  AUTO
}

enum RightsStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LicenceType {
  USER_OWNED
  CREATOR_AUTHORIZED
  CREATIVE_COMMONS
  PUBLIC_DOMAIN
  OTHER
}

enum ClipStatus {
  GENERATED
  APPROVED
  REJECTED
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
}

enum VideoPrivacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String?
  googleId           String?             @unique
  avatarUrl          String?
  role               String              @default("USER")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  youtubeAccounts    YouTubeAccount[]
  sourceVideos       SourceVideo[]
  automationSettings AutomationSettings?
  activityLogs       ActivityLog[]

  @@map("users")
}

model YouTubeAccount {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId            String            @unique
  channelTitle         String
  channelCustomUrl     String?
  channelThumbnail     String?
  encryptedAccessToken String
  encryptedRefreshToken String
  tokenExpiry          DateTime
  scopes               String[]
  isConnected          Boolean           @default(true)
  connectedAt          DateTime          @default(now())
  lastSyncAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  publishingQueues     PublishingQueue[]
  publishedVideos      PublishedVideo[]

  @@index([userId])
  @@map("youtube_accounts")
}

model SourceVideo {
  id                    String               @id @default(uuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeUrl            String?
  youtubeVideoId        String?
  title                 String
  creatorName           String?
  description           String?
  contentCategory       String               @default("Entertainment")
  preferredClipCount    Int                  @default(3)
  preferredClipDuration Int                  @default(45) // in seconds (10-59s)
  editingFormat         EditingFormat        @default(SPLIT_SCREEN)
  publishingPreference  PublishingPreference @default(MANUAL)
  presetId              String?
  preset                EditingPreset?       @relation(fields: [presetId], references: [id], onDelete: SetNull)
  backgroundMediaId     String?
  backgroundMedia       BackgroundMedia?     @relation(fields: [backgroundMediaId], references: [id], onDelete: SetNull)
  localFilePath         String?
  originalFilename      String?
  fileSize              BigInt?
  durationSeconds       Float?
  width                 Int?
  height                Int?
  fps                   Float?               @default(30)
  status                String               @default("SUBMITTED")
  isDuplicate           Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  rightsRecord          RightsRecord?
  processingJobs        ProcessingJob[]
  transcript            Transcript?
  highlights            Highlight[]
  clips                 Clip[]

  @@index([userId])
  @@index([status])
  @@map("source_videos")
}

model RightsRecord {
  id                  String       @id @default(uuid())
  sourceVideoId       String       @unique
  sourceVideo         SourceVideo  @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  rightsHolder        String
  permissionStatus    RightsStatus @default(PENDING)
  licenceType         LicenceType  @default(USER_OWNED)
  canEdit             Boolean      @default(true)
  canRepublish        Boolean      @default(true)
  canCommercialize    Boolean      @default(false)
  attributionRequired Boolean      @default(false)
  attributionText     String?
  evidenceNotes       String?
  verifiedAt          DateTime?
  verifiedBy          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("rights_records")
}

model ProcessingJob {
  id            String      @id @default(uuid())
  sourceVideoId String
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  type          String      @default("FULL_PIPELINE")
  status        JobStatus   @default(SUBMITTED)
  progress      Int         @default(0) // 0-100
  currentStage  String      @default("Initializing")
  errorMessage  String?
  errorDetails  String?
  retryCount    Int         @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sourceVideoId])
  @@index([status])
  @@map("processing_jobs")
}

model Transcript {
  id               String              @id @default(uuid())
  sourceVideoId    String              @unique
  sourceVideo      SourceVideo         @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  language         String              @default("en")
  detectedLanguage String              @default("en")
  fullText         String              @db.Text
  duration         Float
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  segments         TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String     @id @default(uuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segmentIndex Int
  startSec     Float
  endSec       Float
  text         String     @db.Text
  words        Json?      // [{word: string, start: float, end: float, probability: float}]
  avgLogprob   Float?
  noSpeechProb Float?
  createdAt    DateTime   @default(now())

  @@index([transcriptId])
  @@map("transcript_segments")
}

model Highlight {
  id                String      @id @default(uuid())
  sourceVideoId     String
  sourceVideo       SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  startSec          Float
  endSec            Float
  durationSec       Float
  hook              String
  category          String
  overallScore      Float
  hookScore         Float
  interestingScore  Float
  emotionalScore    Float
  contextScore      Float
  retentionScore    Float
  endingScore       Float
  reason            String      @db.Text
  transcriptText    String      @db.Text
  contextAssessment String?     @db.Text
  captionSuggestion String?     @db.Text
  isSelected        Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  clips             Clip[]

  @@index([sourceVideoId])
  @@map("highlights")
}

model Clip {
  id                String          @id @default(uuid())
  sourceVideoId     String
  sourceVideo       SourceVideo     @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  highlightId       String?
  highlight         Highlight?      @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  title             String
  description       String          @db.Text
  hashtags          String[]
  hookSuggestion    String?
  editingFormat     EditingFormat   @default(SPLIT_SCREEN)
  presetId          String?
  preset            EditingPreset?  @relation(fields: [presetId], references: [id], onDelete: SetNull)
  backgroundMediaId String?
  backgroundMedia   BackgroundMedia? @relation(fields: [backgroundMediaId], references: [id], onDelete: SetNull)
  outputFilePath    String?
  thumbnailPath     String?
  durationSec       Float?
  width             Int?            @default(1080)
  height            Int?            @default(1920)
  fps               Float?          @default(30)
  fileSize          BigInt?
  qualityChecked    Boolean         @default(false)
  qualityScore      Float?
  qualityDetails    Json?
  status            ClipStatus      @default(GENERATED)
  approvedAt        DateTime?
  scheduledFor      DateTime?
  publishedAt       DateTime?
  youtubeVideoId    String?
  youtubeVideoUrl   String?
  renderSettings    Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  publishingQueue   PublishingQueue?
  publishedVideo    PublishedVideo?

  @@index([sourceVideoId])
  @@index([status])
  @@map("clips")
}

model EditingPreset {
  id                 String        @id @default(uuid())
  name               String        @unique
  description        String?
  format             EditingFormat @default(SPLIT_SCREEN)
  splitRatio         Float         @default(0.5) // Upper to lower ratio
  captionPreset      String        @default("Dynamic Captions")
  fontName           String        @default("Montserrat")
  fontSize           Int           @default(64)
  primaryColor       String        @default("&H00FFFFFF") // ASS BGR color
  highlightColor     String        @default("&H0000FFFF") // ASS Yellow
  outlineColor       String        @default("&H00000000") // Black outline
  outlineWidth       Float         @default(3.0)
  position           String        @default("center")
  animationType      String        @default("word_highlight") // pop, bounce, word_highlight
  audioNormalization Boolean       @default(true)
  isDefault          Boolean       @default(false)
  facecamPosition    String?       @default("top_right") // top_right, top_left, bottom_right, bottom_left
  facecamSize        String?       @default("medium") // small (25%), medium (32%), large (40%)
  facecamBorderWidth Float?        @default(4.0)
  facecamBorderColor String?       @default("#3B82F6") // Blue border
  facecamCornerRadius Float?       @default(20.0)
  subtleZoom         Boolean       @default(false)
  cropMode           String        @default("smart") // smart, center
  maxWordsPerLine    Int           @default(4)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  clips              Clip[]
  sourceVideos       SourceVideo[]

  @@map("editing_presets")
}

model BackgroundMedia {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("Gameplay")
  filePath    String
  durationSec Float
  width       Int
  height      Int
  fps         Float    @default(30)
  fileSize    BigInt
  isLoopable  Boolean  @default(true)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clips       Clip[]
  sourceVideos SourceVideo[]

  @@map("background_media")
}

model PublishingQueue {
  id               String         @id @default(uuid())
  clipId           String         @unique
  clip             Clip           @relation(fields: [clipId], references: [id], onDelete: Cascade)
  youtubeAccountId String
  youtubeAccount   YouTubeAccount @relation(fields: [youtubeAccountId], references: [id], onDelete: Cascade)
  scheduledTime    DateTime
  priority         Int            @default(0)
  status           String         @default("QUEUED") // QUEUED, UPLOADING, PUBLISHED, FAILED
  attempts         Int            @default(0)
  lastAttemptAt    DateTime?
  errorMessage     String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@map("publishing_queue")
}

model PublishedVideo {
  id                  String              @id @default(uuid())
  clipId              String              @unique
  clip                Clip                @relation(fields: [clipId], references: [id], onDelete: Cascade)
  youtubeAccountId    String
  youtubeAccount      YouTubeAccount      @relation(fields: [youtubeAccountId], references: [id], onDelete: Cascade)
  youtubeVideoId      String              @unique
  youtubeUrl          String
  title               String
  description         String              @db.Text
  privacyStatus       VideoPrivacy        @default(PUBLIC)
  publishedAt         DateTime            @default(now())
  views               Int                 @default(0)
  likes               Int                 @default(0)
  comments            Int                 @default(0)
  lastAnalyticsSyncAt DateTime?
  rawAnalytics        Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  analyticsSnapshots  AnalyticsSnapshot[]

  @@index([youtubeAccountId])
  @@index([publishedAt])
  @@map("published_videos")
}

model AnalyticsSnapshot {
  id                     String         @id @default(uuid())
  publishedVideoId       String
  publishedVideo         PublishedVideo @relation(fields: [publishedVideoId], references: [id], onDelete: Cascade)
  youtubeAccountId       String
  timestamp              DateTime       @default(now())
  views                  Int            @default(0)
  likes                  Int            @default(0)
  comments               Int            @default(0)
  watchTimeMinutes       Float          @default(0)
  averageViewDurationSec Float          @default(0)
  createdAt              DateTime       @default(now())

  @@index([publishedVideoId])
  @@index([timestamp])
  @@map("analytics")
}

model AutomationSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoPublishEnabled   Boolean  @default(false)
  maxDailyUploads      Int      @default(4)
  preferredPostingTimes Json    // e.g. ["10:00", "14:00", "18:00", "21:00"]
  timezone             String   @default("Asia/Kolkata")
  paused               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("automation_settings")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String   // VIDEO, CLIP, YOUTUBE, PUBLISHING, SYSTEM
  entityId   String?
  action     String   // SUBMITTED, ANALYZED, RENDERED, APPROVED, PUBLISHED, ERROR
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}
