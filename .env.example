# ==============================================================================
# CLIPPILOT AI - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions: Copy this file to .env and configure with your actual credentials.
# Note: Database and Redis work out-of-the-box with default local settings or Docker.

# Google Gemini API Key (Required for AI Highlight analysis and metadata generation)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# YouTube Data API v3 Google OAuth 2.0 Credentials (Required for automated YouTube Shorts publishing)
# Obtain at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clippilot?schema=public
POSTGRES_DB=clippilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration (For BullMQ Job Queue)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Security & Encryption Secrets
# Generate random 32-character or 64-character hex strings in production
JWT_SECRET=clippilot_jwt_super_secret_key_change_in_production_32chars!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Hardware & Processing Limits (Optimized for Intel Core i5 / 16GB RAM)
MAX_CONCURRENT_JOBS=1
MAX_CLIPS_PER_SOURCE=5
MAX_DAILY_UPLOADS=4
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AI_ENGINE_URL=http://localhost:8001

# Storage Paths (Local absolute or relative paths)
VIDEO_OUTPUT_DIR=d:/clippilot AI/media/output
VIDEO_TEMP_DIR=d:/clippilot AI/media/temp
VIDEO_UPLOADS_DIR=d:/clippilot AI/media/uploads
BACKGROUND_MEDIA_DIR=d:/clippilot AI/media/backgrounds

# Environment
NODE_ENV=development

# Gemini
GEMINI_MODEL=gemini-2.5-flash

# YouTube permissions
YOUTUBE_UPLOAD_SCOPE=https://www.googleapis.com/auth/youtube.upload
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_TIMEZONE=Asia/Kolkata

# Video output
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac

# Publishing safety
AUTO_PUBLISH_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true

# Transcription
WHISPER_DEVICE=cpu

# Application
PORT=8000
AI_ENGINE_PORT=8001